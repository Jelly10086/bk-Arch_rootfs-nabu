#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd "$(dirname "$0")/.." && pwd)
rootfs="$project_dir/output/bk-nabu-rootfs"
uki="$project_dir/output/arch-linux-nabu.efi"
kernel_link=$(readlink "$rootfs/boot/vmlinuz-linux-nabu")
expected_release=${kernel_link#vmlinuz-}
[[ $expected_release == 6.18.42-sm8150 ]]
grep -qx "kernel.release=$expected_release" "$rootfs/usr/lib/bk/build-info"
if [[ ${BK_PUBLIC_BUILD:-0} == 1 ]]; then
  expected_cjk_path=/usr/share/fonts/bk/NotoSansSC-Regular.otf
else
  expected_cjk_path=/usr/share/fonts/local/cjk-regular.ttf
fi

[[ $(<"$rootfs/etc/hostname") == mipad5 ]]
grep -qx 'NAME="XiaomiPad5"' "$rootfs/etc/os-release"
grep -qx 'PRETTY_NAME="XiaomiPad5"' "$rootfs/etc/os-release"
grep -qx 'ID=xiaomipad5' "$rootfs/etc/os-release"
grep -qx 'PARTLABEL=linux  /          ext4  rw,errors=remount-ro,x-systemd.growfs  0 1' \
  "$rootfs/etc/fstab"
grep -qx 'PARTLABEL=esp    /boot/efi  vfat  rw,nofail,x-systemd.device-timeout=10s,umask=0077  0 2' \
  "$rootfs/etc/fstab"
[[ -d $rootfs/usr/lib/modules/$expected_release ]]
[[ -f $rootfs/boot/vmlinuz-$expected_release ]]
[[ -f $rootfs/boot/dtb-$expected_release ]]
[[ -f $uki ]]

kernel_config="$rootfs/boot/config-$expected_release"
for symbol in \
  ARCH_QCOM SCSI_UFS_QCOM QCOM_RMTFS_MEM QCOM_GPI_DMA I2C_QCOM_GENI \
  PINCTRL_SM8150 SM_GCC_8150 SM_GPUCC_8150 SM_VIDEOCC_8150 \
  SM_DISPCC_8250 INTERCONNECT_QCOM_OSM_L3 INTERCONNECT_QCOM_SM8150 \
  DRM_MSM DRM_PANEL_NOVATEK_NT36523 TOUCHSCREEN_NT36523_SPI \
  BACKLIGHT_KTZ8866 SND_SOC_SM8150 CHARGER_IDTP9418 ATH10K ATH10K_SNOC \
  BT_QCA BT_HCIUART_QCA PHY_QCOM_QMP_UFS EXT4_FS VFAT_FS; do
  grep -Eq "^CONFIG_${symbol}=[ym]$" "$kernel_config"
done

while IFS= read -r symbol; do
  if grep -Eq "^CONFIG_${symbol}=[ym]$" "$kernel_config"; then
    printf 'pruned kernel option is still enabled: CONFIG_%s\n' "$symbol" >&2
    exit 1
  fi
done < <(sed -n 's/^# CONFIG_\([A-Z0-9_]*\) is not set$/\1/p' \
  "$project_dir/packages/linux-nabu/bk-nabu-prune.config")

ukify inspect "$uki" | grep -A5 '^\.uname:' | grep -qx "    $expected_release"
ukify inspect "$uki" | grep -q '^\.dtb:'
ukify inspect "$uki" | grep -q '^\.initrd:'
ukify inspect "$uki" | grep -A8 '^\.cmdline:' \
  | grep -q 'root=PARTLABEL=linux rw'

grep -q 'exec-once = noctalia' "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q '^exec-once = noctalia-pad-osk start$' \
  "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q 'gaps_in = 8' "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q '^monitor = DSI-1, preferred, auto, 1.6, transform, 3$' \
  "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q '^        output = DSI-1$' "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q '^        transform = 3$' "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q '^    hide_on_touch = true$' "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q '^bind = SUPER, F, togglefloating$' \
  "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q '^windowrule = float on, match:class \.\*$' \
  "$rootfs/home/unkn0wn/.config/hypr/hyprland.conf"
grep -q 'noctalia-pad-osk toggle' "$rootfs/home/unkn0wn/.config/noctalia/config.toml"
grep -q '^glyph = "keyboard"$' "$rootfs/home/unkn0wn/.config/noctalia/config.toml"
grep -q 'command = "/usr/bin/noctalia-greeter-end4-session"' \
  "$rootfs/usr/lib/noctalia-greeter/config.toml"
grep -q 'command = "/usr/bin/noctalia-greeter-end4-session"' \
  "$rootfs/etc/greetd/config.toml"
grep -q 'user = "greeter"' "$rootfs/etc/greetd/config.toml"
grep -q '^ExecStart=/usr/bin/greetd --config /usr/lib/noctalia-greeter/config.toml$' \
  "$rootfs/usr/lib/systemd/system/greetd.service.d/20-noctalia-greeter.conf"
[[ -f $rootfs/usr/share/icons/Papirus-Dark/index.theme ]]
[[ -f $rootfs/usr/share/noctalia-greeter/greeter.toml ]]
grep -q '^monitor = DSI-1, preferred, auto, 1.6, transform, 3$' \
  "$rootfs/usr/share/noctalia-greeter/hyprland-end4.conf"
grep -q '^        transform = 3$' \
  "$rootfs/usr/share/noctalia-greeter/hyprland-end4.conf"
! grep -q -- '--session niri' "$rootfs/usr/share/noctalia-greeter/greetd_setup_lib.sh"
[[ -f $rootfs/usr/lib/systemd/user/noctalia-pad-osk.service ]]
grep -Fq 'qs -p "$end4_root/end4-osk-session.qml"' \
  "$rootfs/usr/bin/noctalia-pad-osk"
grep -Fq 'ipc call osk toggle' "$rootfs/usr/bin/noctalia-pad-osk"
for end4_file in \
  modules/ii/onScreenKeyboard/OskContent.qml \
  services/Ydotool.qml; do
  cmp \
    "$rootfs/usr/share/noctalia-pad/end4-osk/ii/$end4_file" \
    "$project_dir/cache/sources/git/dots-hyprland/dots/.config/quickshell/ii/$end4_file"
done
grep -Fq 'icon: "icons/bolt-boost.svg"' \
  "$rootfs/usr/share/noctalia-pad/end4-osk/ii/modules/ii/onScreenKeyboard/layouts.js"
grep -Fq 'keycode: 125' \
  "$rootfs/usr/share/noctalia-pad/end4-osk/ii/modules/ii/onScreenKeyboard/layouts.js"
grep -Fq 'Qt.resolvedUrl(root.keyData.icon)' \
  "$rootfs/usr/share/noctalia-pad/end4-osk/ii/modules/ii/onScreenKeyboard/OskKey.qml"
[[ -f $rootfs/usr/share/noctalia-pad/end4-osk/ii/modules/ii/onScreenKeyboard/icons/bolt-boost.svg ]]
grep -Fq 'component ResizeHandle: Item' \
  "$rootfs/usr/share/noctalia-pad/end4-osk/ii/modules/ii/onScreenKeyboard/OnScreenKeyboard.qml"
grep -Fq 'Layout.minimumHeight: 44' \
  "$rootfs/usr/share/noctalia-pad/end4-osk/ii/modules/ii/onScreenKeyboard/OnScreenKeyboard.qml"
grep -Fq 'external-osk-set' "$rootfs/usr/bin/noctalia-pad-osk"
! find "$rootfs/usr/bin" -maxdepth 1 -iname 'wvkbd*' -print -quit | grep -q .
! find "$rootfs/etc" "$rootfs/usr/lib/systemd" "$rootfs/usr/share" -xdev \
  \( -iname dms -o -iname 'dms-*' -o -iname '*-dms' \
     -o -iname dank -o -iname 'dank-*' -o -iname '*-dank' \
     -o -iname niri -o -iname 'niri-*' -o -iname '*-niri' \
     -o -iname 'bk-keyboard*' -o -iname 'bk-shell*' \
     -o -iname 'wifi-diag*' \) \
  -print -quit | grep -q .

systemd-nspawn --quiet --directory="$rootfs" --register=no \
  --setenv=BK_CJK_PATH="$expected_cjk_path" \
  /usr/bin/bash -lc '
    test "$(id -u unkn0wn)" = 1000
    test "$(getent passwd unkn0wn | cut -d: -f5)" = Unkn0wn
    test "$(getent passwd unkn0wn | cut -d: -f7)" = /bin/zsh
    passwd -S root | grep -q "^root L"
    id -nG unkn0wn | tr " " "\n" | grep -qx wheel
    id -nG unkn0wn | tr " " "\n" | grep -qx input
    id -nG unkn0wn | tr " " "\n" | grep -qx greeter
    pacman -Qk bk-defaults bk-log bk-packagelist noctalia-pad noctalia-greeter-pad noctalia-pad-osk linux-nabu yay
    pacman -Q hyprland noctalia-pad noctalia-greeter-pad noctalia-pad-osk \
      quickshell ydotool qt6-positioning qt6-multimedia qt6-quicktimeline \
      qt6-sensors qt6-virtualkeyboard kirigami kdialog syntax-highlighting \
      ttf-material-symbols-variable papirus-icon-theme >/dev/null
    ! pacman -Q niri >/dev/null 2>&1
    ! pacman -Q bk-keyboard >/dev/null 2>&1
    test -x /usr/bin/Hyprland
    test -x /usr/bin/noctalia
    test -x /usr/bin/noctalia-greeter
    test -x /usr/bin/noctalia-greeter-session
    test -x /usr/bin/noctalia-greeter-end4-session
    test -x /usr/bin/noctalia-pad-osk
    test -x /usr/bin/qs
    test -x /usr/bin/ydotool
    test -x /usr/bin/ydotoold
    id -nG greeter | tr " " "\n" | grep -qx input
    id -nG greeter | tr " " "\n" | grep -qx video
    id -nG greeter | tr " " "\n" | grep -qx render
    test "$(gsettings get org.gnome.desktop.interface icon-theme)" = "'Papirus-Dark'"
    [[ "$(fc-match -f "%{family}\n" Rubik)" == *Rubik* ]]
    test "$(fc-match -f "%{file}" :lang=zh)" = "$BK_CJK_PATH"
    [[ "$(fc-match -f "%{family}\n" emoji)" == *"Noto Color Emoji"* ]]
    test "$(fc-match -f "%{family}\n" monospace)" != Rubik
  '

for service in NetworkManager bluetooth greetd nabu-pmac rmtfs tqftpserv; do
  systemctl --root="$rootfs" is-enabled "$service.service" >/dev/null
done
[[ $(systemctl --root="$rootfs" --global is-enabled noctalia-pad-osk.service) == enabled ]]
[[ $(systemctl --root="$rootfs" --global is-enabled ydotool.service) == enabled ]]

headers_package=$(find "$project_dir/output/packages" -maxdepth 1 -type f \
  -name 'linux-nabu-headers-*.pkg.tar.*' -print -quit)
[[ -n $headers_package ]]
for tool in scripts/basic/fixdep scripts/mod/modpost; do
  bsdtar -xOf "$headers_package" \
    "usr/lib/modules/$expected_release/build/$tool" \
    | file -b - | grep -q 'ARM aarch64'
done

e2fsck -fn "$project_dir/output/bk-nabu-rootfs.img"
[[ $(tune2fs -l "$project_dir/output/bk-nabu-rootfs.img" | awk -F: \
  '$1 == "Filesystem volume name" { gsub(/^[[:space:]]+/, "", $2); print $2 }') == linux ]]
! tune2fs -l "$project_dir/output/bk-nabu-rootfs.img" \
  | awk -F: '$1 == "Filesystem features" { print $2 }' \
  | grep -qw orphan_file
if [[ ${BK_VERIFY_ROOTFS_ONLY:-0} != 1 ]]; then
  fsck.fat -vn "$project_dir/output/esp.img" \
    | grep -q '^      4096 bytes per logical sector$'
  mtype -i "$project_dir/output/esp.img" ::/EFI/BOOT/refind.conf \
    | grep -q '^include themes/rEFInd-tokyo-night/theme.conf$'
fi
(
  cd "$project_dir/output"
  sha256sum -c SHA256SUMS
)
