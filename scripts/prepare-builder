#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd "$(dirname "$0")/.." && pwd)
builder_root=${BK_BUILDER_ROOT:-"$project_dir/build/builder-root"}
rootfs_archive="$project_dir/cache/ArchLinuxARM-aarch64-latest.tar.gz"
host_resolv=$(readlink -f /etc/resolv.conf)
package_file="$project_dir/ci/archlinuxarm-builder-packages.txt"
builder_stamp="$builder_root/.bk-builder-packages"

mapfile -t builder_packages < <(
  sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$package_file"
)
builder_key=$(sha256sum "$package_file" | awk '{print $1}')

if [[ ! -x "$builder_root/usr/bin/pacman" ]]; then
  [[ -f $rootfs_archive ]] || {
    echo "missing Arch Linux ARM rootfs: $rootfs_archive" >&2
    exit 1
  }
  case $builder_root in
    "$project_dir"/build/builder-root) ;;
    *) echo "unsafe builder path: $builder_root" >&2; exit 1 ;;
  esac
  rm -rf -- "$builder_root"
  mkdir -p "$builder_root"
  # A rootless user namespace cannot restore security.capability xattrs.
  bsdtar -xf "$rootfs_archive" -C "$builder_root" \
    --no-xattrs --no-acls --no-fflags
fi

if [[ -f $builder_stamp && $(<"$builder_stamp") == "$builder_key" ]]; then
  printf '%s\n' "$builder_root"
  exit 0
fi

mkdir -p "$builder_root/workspace" "$builder_root/mnt" \
  "$builder_root/run/systemd/resolve"

bwrap \
  --unshare-user --uid 0 --gid 0 \
  --unshare-pid --unshare-uts --unshare-ipc --share-net \
  --die-with-parent \
  --bind "$builder_root" / \
  --proc /proc --dev /dev --ro-bind /sys /sys --tmpfs /tmp \
  --ro-bind "$host_resolv" /run/systemd/resolve/resolv.conf \
  --setenv HOME /root \
  /usr/bin/bash -lc '
    set -e
    if [[ ! -s /etc/pacman.d/gnupg/pubring.gpg ]]; then
      pacman-key --init
      pacman-key --populate archlinuxarm
    fi
    pacman -Syu --needed --noconfirm --disable-sandbox -- "$@"
    sed -i "s/!ccache/ccache/" /etc/makepkg.conf
  ' bash "${builder_packages[@]}" >&2

printf '%s\n' "$builder_key" >"$builder_stamp"

printf '%s\n' "$builder_root"
