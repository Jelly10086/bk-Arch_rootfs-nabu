#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd "$(dirname "$0")/.." && pwd)
package_output="$project_dir/output/packages"

mkdir -p "$package_output"

case $(uname -m) in
  aarch64|arm64)
    package_builder="$project_dir/scripts/build-package-native"
    build_description='native AArch64 toolchain'
    ;;
  x86_64)
    package_builder="$project_dir/scripts/build-package-host"
    build_description='x86_64 host cross toolchain'
    ;;
  *)
    printf 'unsupported build host architecture: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac

all_packages=(bk-packagelist bk-log bk-defaults noctalia-pad noctalia-greeter-pad noctalia-pad-osk tqftpserv yay linux-nabu)
if (($#)); then
  packages_to_build=("$@")
else
  packages_to_build=("${all_packages[@]}")
fi

for package_dir in "${packages_to_build[@]}"; do
  case " ${all_packages[*]} " in
    *" $package_dir "*) ;;
    *) printf 'unknown package: %s\n' "$package_dir" >&2; exit 2 ;;
  esac
  printf 'Building %s with %s\n' "$package_dir" "$build_description"
  "$package_builder" "$package_dir"
done

for package_file in "$project_dir/cache/sources/nabu-repo/"*.pkg.tar.xz; do
  [[ -e $package_file ]] || continue
  case ${package_file##*/} in
    linux-firmware-xiaomi-nabu-*|nabu-pmac-*) ;;
    *) continue ;;
  esac
  install -m644 "$package_file" "$package_output/"
done

(
  cd "$package_output"
  shopt -s nullglob
  packages=(./*.pkg.tar.zst ./*.pkg.tar.xz)
  ((${#packages[@]}))
  for repository_file in bk.db bk.db.tar.zst bk.files bk.files.tar.zst; do
    [[ ! -e $repository_file && ! -L $repository_file ]] || \
      unlink -- "$repository_file"
  done
  repo-add bk.db.tar.zst "${packages[@]}"
)
(
  cd "$package_output"
  find . -maxdepth 1 -type f \( -name '*.pkg.tar.zst' -o -name '*.pkg.tar.xz' \) \
    -printf '%f\0' | LC_ALL=C sort -z | xargs -0 sha256sum -- >SHA256SUMS
)
