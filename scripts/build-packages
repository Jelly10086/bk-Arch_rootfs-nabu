#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd "$(dirname "$0")/.." && pwd)
workspace_parent=$(dirname "$project_dir")
builder_root=$("$project_dir/scripts/prepare-builder")
package_output="$project_dir/output/packages"
shell_dir="$workspace_parent/bk-shell"
mkosi_version=$(mkosi --version | awk '{print $2}')
distro_commit=$(git -C "$project_dir" rev-parse HEAD)
shell_commit=$(git -C "$shell_dir" rev-parse HEAD)

mkdir -p "$package_output" "$project_dir/cache/sources/makepkg" \
  "$project_dir/build/makepkg" "$project_dir/logs/makepkg"

build_one() {
  local package_dir=$1
  local container_dir="/workspace/bk-Arch_nabu/packages/$package_dir"
  printf 'Building %s in AArch64 builder\n' "$package_dir"
  bwrap \
    --unshare-user --uid 1000 --gid 1000 \
    --unshare-pid --unshare-uts --unshare-ipc --share-net \
    --die-with-parent \
    --bind "$builder_root" / \
    --proc /proc --dev /dev --ro-bind /sys /sys --tmpfs /tmp \
    --bind "$workspace_parent" /workspace \
    --setenv HOME /tmp/bk-home \
    --setenv PKGDEST /workspace/bk-Arch_nabu/output/packages \
    --setenv SRCDEST /workspace/bk-Arch_nabu/cache/sources/makepkg \
    --setenv BUILDDIR /workspace/bk-Arch_nabu/build/makepkg \
    --setenv LOGDEST /workspace/bk-Arch_nabu/logs/makepkg \
    --setenv PACKAGER 'BK nabu build' \
    --setenv MAKEFLAGS "-j$(nproc)" \
    --setenv BK_SHELL_SOURCE /workspace/bk-shell \
    --setenv BK_DISTRO_COMMIT "$distro_commit" \
    --setenv BK_SHELL_COMMIT "$shell_commit" \
    --setenv BK_MKOSI_VERSION "$mkosi_version" \
    --chdir "$container_dir" \
    /usr/bin/bash -lc 'mkdir -p "$HOME"; exec makepkg --noconfirm --cleanbuild --clean --force --nodeps'
}

all_packages=(bk-packagelist bk-log bk-defaults bk-shell yay linux-nabu)
packages_to_build=("${@:-${all_packages[@]}}")

for package_dir in "${packages_to_build[@]}"; do
  case " ${all_packages[*]} " in
    *" $package_dir "*) ;;
    *) printf 'unknown package: %s\n' "$package_dir" >&2; exit 2 ;;
  esac
  build_one "$package_dir"
done

install -m644 "$project_dir/cache/sources/nabu-repo/"*.pkg.tar.xz "$package_output/"

repo-add -R "$package_output/bk.db.tar.zst" \
  "$package_output"/*.pkg.tar.zst "$package_output"/*.pkg.tar.xz
(
  cd "$package_output"
  sha256sum -- *.pkg.tar.zst *.pkg.tar.xz >SHA256SUMS
)
