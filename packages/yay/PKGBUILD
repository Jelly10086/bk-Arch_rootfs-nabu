pkgname=yay
pkgver=13.0.1
pkgrel=1
pkgdesc="Yet another yogurt: a Pacman wrapper and AUR helper written in Go"
arch=('aarch64')
url="https://github.com/Jguer/yay"
license=('GPL-3.0-only')
depends=('git' 'pacman>=6.1')
makedepends=('go>=1.24' 'gettext')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b77454bce87110180a1b6664c2d260de78124c9894b71101610ba84f551eb0d0')

build() {
  cd "$pkgname-$pkgver"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  make VERSION="$pkgver" PREFIX=/usr build
}

package() {
  cd "$pkgname-$pkgver"
  make VERSION="$pkgver" DESTDIR="$pkgdir" PREFIX=/usr install
}
