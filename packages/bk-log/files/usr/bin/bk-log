#!/usr/bin/env bash
set -uo pipefail

umask 077
output_dir=$PWD
since="-2h"

usage() {
  printf '%s\n' \
    'Usage: bk-log [--output-dir DIR] [--since JOURNAL_TIME]' \
    'Collects and redacts local diagnostics. Nothing is uploaded.'
}

while (($#)); do
  case $1 in
    --output-dir)
      (($# >= 2)) || { echo 'bk-log: --output-dir requires a value' >&2; exit 2; }
      output_dir=$2
      shift 2
      ;;
    --since)
      (($# >= 2)) || { echo 'bk-log: --since requires a value' >&2; exit 2; }
      since=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "bk-log: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

mkdir -p "$output_dir"
output_dir=$(realpath "$output_dir")
work_dir=$(mktemp -d -t bk-log.XXXXXXXX)
log_dir=$work_dir/bk-log
mkdir -p "$log_dir"
trap 'rm -rf -- "$work_dir"' EXIT

capture() {
  local name=$1
  shift
  {
    printf 'command:'
    printf ' %q' "$@"
    printf '\n\n'
    timeout 15 "$@"
  } >"$log_dir/$name.txt" 2>&1 || true
}

capture_shell() {
  local name=$1
  shift
  {
    printf 'command: %s\n\n' "$*"
    timeout 15 bash -c "$*"
  } >"$log_dir/$name.txt" 2>&1 || true
}

capture system-uname uname -a
capture system-release cat /etc/os-release
capture system-hostname hostnamectl
capture system-boot systemd-analyze
capture boot-journal journalctl --boot --no-pager --since "$since"
capture kernel-journal journalctl --dmesg --boot --no-pager
capture kernel-dmesg dmesg --color=never
capture kernel-cmdline cat /proc/cmdline
capture kernel-modules lsmod
capture packages pacman -Q
capture failed-units systemctl --failed --no-pager
capture system-units systemctl status NetworkManager bluetooth systemd-resolved rmtfs pd-mapper qrtr-ns greetd --no-pager
capture user-units systemctl --user status niri dms bk-shell fcitx5 --no-pager
capture session-journal journalctl --user --boot --no-pager --since "$since"

capture drm-sysfs find /sys/class/drm -maxdepth 3 -type f -name status -o -name modes
capture gpu-journal journalctl --boot --no-pager -g 'drm|gpu|dpu|adreno|a6xx|firmware'
capture input-devices cat /proc/bus/input/devices
capture input-journal journalctl --boot --no-pager -g 'touch|goodix|hid|input|iio|sensor'
capture power-supply udevadm info --export-db
capture battery upower --dump
capture backlight brightnessctl info

capture usb lsusb -v
capture network ip address show
capture routes ip route show table all
capture wifi nmcli --show-secrets no device wifi list
capture connections nmcli --show-secrets no connection show
capture radio rfkill list
capture bluetooth bluetoothctl show
capture bluetooth-devices bluetoothctl devices
capture qcom-journal journalctl --boot --no-pager -g 'qrtr|rmtfs|remoteproc|qcom|ipa|ath10k|ath11k'

capture audio wpctl status
capture audio-devices pactl list
capture wireplumber-journal journalctl --user --boot --no-pager -u wireplumber
capture pipewire-journal journalctl --user --boot --no-pager -u pipewire -u pipewire-pulse
capture niri niri msg version
capture niri-outputs niri msg outputs
capture niri-journal journalctl --user --boot --no-pager -u niri
capture shell-journal journalctl --user --boot --no-pager -u dms -u bk-shell
capture greeter-journal journalctl --boot --no-pager -u greetd
capture input-method-journal journalctl --user --boot --no-pager -u fcitx5
capture_shell filesystems 'findmnt --real --output SOURCE,TARGET,FSTYPE,OPTIONS; lsblk --output NAME,TYPE,SIZE,FSTYPE,LABEL,PARTLABEL,MOUNTPOINTS'

redact_file() {
  local file=$1
  sed -E -i \
    -e 's#(/home/)[^/[:space:]]+#\1_user_#g' \
    -e 's#([Uu][Ss][Ee][Rr][Nn][Aa][Mm][Ee]|[Uu][Ss][Ee][Rr]|[Ll][Oo][Gg][Nn][Aa][Mm][Ee])=[^[:space:]]+#\1=_user_#g' \
    -e 's#([[:alnum:]._%+-]+)@([[:alnum:].-]+\.[[:alpha:]]{2,})#_email_#g' \
    -e 's#(^|[^[:xdigit:]])([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}([^[:xdigit:]]|$)#\1_mac_address_\3#g' \
    -e 's#(^|[^[:digit:]])(([0-9]{1,3}\.){3}[0-9]{1,3})([^[:digit:]]|$)#\1_ip_address_\4#g' \
    -e 's#([Ss][Ss][Ii][Dd][=: ]+)("[^"]*"|[^[:space:]]+)#\1_ssid_#g' \
    -e 's#([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Ss][Kk]|[Ss][Ee][Cc][Rr][Ee][Tt])([=: ]+)("[^"]*"|[^[:space:]]+)#\1\2_redacted_#g' \
    -e 's#([Ss][Ee][Rr][Ii][Aa][Ll]([Nn][Uu][Mm][Bb][Ee][Rr])?)[=: ]+[^[:space:]]+#\1=_serial_#g' \
    -e 's#[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}#_uuid_#g' \
    "$file"
}

while IFS= read -r -d '' file; do
  redact_file "$file"
done < <(find "$log_dir" -type f -print0)

archive="$output_dir/bk-log-$(date +%Y%m%d-%H%M%S).tar.zst"
bsdtar --format=gnutar --uid 0 --gid 0 --uname root --gname root \
  -C "$work_dir" -cf - bk-log | zstd -q -T0 -10 -o "$archive"
chmod 0600 "$archive"
printf '%s\n' "$archive"
