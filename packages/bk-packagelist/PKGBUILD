pkgname=bk-packagelist
pkgver=1.0.0
pkgrel=1
pkgdesc="BK distribution package profile manager"
arch=('any')
url="https://github.com/endeavouros-team/PKGBUILDS/tree/master/eos-packagelist"
license=('GPL-3.0-or-later')
depends=('pacman' 'python')
optdepends=('sudo: install packages as a non-root user')
source=()
sha256sums=()

package() {
  install -Dm755 "$startdir/files/usr/bin/bk-packagelist" \
    "$pkgdir/usr/bin/bk-packagelist"
  install -d "$pkgdir/usr/share/bk/package-lists"
  install -m644 "$startdir"/files/usr/share/bk/package-lists/* \
    "$pkgdir/usr/share/bk/package-lists/"
}
