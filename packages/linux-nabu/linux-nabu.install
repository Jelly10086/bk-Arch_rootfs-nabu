#!/bin/bash

regenerate_uki() {
  local kernel_image kernver
  kernel_image=$(readlink -f /boot/vmlinuz-linux-nabu 2>/dev/null) || return 0
  kernver=${kernel_image##*/vmlinuz-}
  [[ $kernver == 6.18.42-sm8150* ]] || return 0
  [[ -f /boot/vmlinuz-$kernver ]] || return 0
  mountpoint -q /boot/efi 2>/dev/null || return 0
  install -d /etc/cmdline.d
  printf '%s\n' \
    'root=PARTLABEL=linux rw console=tty0 fbcon=rotate:1 systemd.show_status=yes loglevel=7' \
    >/etc/cmdline.d/root.conf
  mkinitcpio -P
}

post_install() {
  regenerate_uki
}

post_upgrade() {
  regenerate_uki
}
